# Backend — copy to .env in the project root and fill in values.

# Anthropic (required) — Claude API key
ANTHROPIC_API_KEY=

# Supabase (required) — auth
# If these are unset the API FAILS CLOSED (returns 503) unless APP_ENV=development.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App environment. Set to "development" ONLY for local work — it enables an
# unauthenticated dev-admin bypass when Supabase is not configured.
# Set to "production" for any deployed environment (docker-compose does this):
# production REFUSES to start without DATABASE_URL instead of using throwaway SQLite.
APP_ENV=development

# Email that is always granted admin access (one source of truth, backend).
# The frontend reads NEXT_PUBLIC_ADMIN_EMAIL (set it to the same value).
ADMIN_EMAIL=akshatgupta428@gmail.com

# Upstox (primary India market data — quotes, history, news, fundamentals, corporate actions)
# Analytics Token: generated once from https://account.upstox.com/developer/apps — no daily re-auth
UPSTOX_ANALYTICS_TOKEN=

# Finnhub (US quotes, fundamentals, company news)
FINNHUB_API_KEY=

# Crypto: free CoinGecko demo key (optional; public API works but is rate limited)
COINGECKO_API_KEY=

# Market-data fallbacks (optional)
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Database (optional) — defaults to local SQLite if unset
# DATABASE_URL=postgresql://...

# CORS — add your deployed frontend URL here
ALLOWED_ORIGINS=http://localhost:3000

# Frontend URL — used as the redirect target in Supabase auth emails (verify, reset).
# Set to your deployed app URL (e.g. https://your-app.vercel.app).
# Must also be added to Supabase Dashboard → Auth → URL Configuration → Redirect URLs.
FRONTEND_URL=https://your-app.vercel.app

# ── Frontend (frontend/.env.local) ──────────────────────────────
# Base URL the Next.js app calls; defaults to http://localhost:8000
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Reliability / scale ─────────────────────────────────────────
# Where background AI jobs run: "embedded" (threads inside the API, default) or
# "external" (run `python -m src.jobs.worker` as a separate process/container).
# JOB_WORKER_MODE=embedded
# JOB_WORKER_THREADS=2
# LOG_FORMAT=json          # JSON lines for log aggregators
# LOG_TO_FILE=false
# PROVIDER_MONITOR=true    # hourly background check of the Upstox token (logs on failure/expiry)
# TRUST_PROXY=true         # behind a reverse proxy: take client IP from X-Forwarded-For
# RATE_LIMIT_ENABLED=true
# POSTGRES_PASSWORD=...    # used by docker-compose

# Shadow-mode news sentiment for forecasts (off by default; ~1 small Haiku call per symbol per day).
# Scores are only LOGGED with each prediction to test later whether they add anything; they never change the odds.
# SENTIMENT_SHADOW=true
# SENTIMENT_MODEL=claude-haiku-4-5-20251001
