# Backend — copy to .env in the project root and fill in values.

# Anthropic (required) — Claude API key
ANTHROPIC_API_KEY=

# Supabase (required) — auth
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Finnhub (recommended) — US quotes, fundamentals, company news
FINNHUB_API_KEY=

# Market-data fallbacks (optional)
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Database (optional) — defaults to local SQLite if unset
# DATABASE_URL=postgresql://...

# CORS — add your deployed frontend URL here
ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend (frontend/.env.local) ──────────────────────────────
# Base URL the Next.js app calls; defaults to http://localhost:8000
# NEXT_PUBLIC_API_URL=http://localhost:8000
